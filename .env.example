# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# Si se deja vacía, el asistente NEXO AFRO IA funciona con el motor RAG local.
GEMINI_API_KEY=

# Modelo de Gemini (opcional)
GEMINI_MODEL=gemini-3.8-flash

# Servidor de producción (npm start)
PORT=3000
HOST=0.0.0.0
